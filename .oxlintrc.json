{
  "$schema": "./node_modules/oxlint/configuration_schema.json", // 指向 Oxlint 配置的 JSON Schema，提供智能提示

  // 启用需要的插件（必须声明才能使用对应规则）
  "plugins": [
    "react",      // React 相关规则
    "typescript", // TypeScript 相关规则
    "oxc"         // Oxc 内置的通用规则（如性能、最佳实践）
  ],

  // Oxlint 运行时选项
  "options": {
    "typeAware": true // 开启类型感知，使规则能利用 TypeScript 类型信息（需安装 oxlint-tsgolint）
  },

  // 所有规则的配置
  "rules": {
    // ========== TypeScript 核心规则 ==========

    // 禁止使用 any 类型，强制使用更具体的类型
    "typescript/no-explicit-any": "error",

    // 禁止将 any 类型的值赋值给其他变量，避免类型安全被破坏（需要 typeAware）
    "typescript/no-unsafe-assignment": "error",

    // 禁止不必要的类型转换，如 String(foo) 应直接写 foo（需要 typeAware）
    "typescript/no-unnecessary-type-conversion": "error",

    // 禁止冗余的泛型参数，如调用 fn<string>('x') 时如果类型可推断则应省略（需要 typeAware）
    "typescript/no-unnecessary-type-arguments": "error",

    // 禁止使用指定的类型（在此禁止 String 和 Number 包装类型，强制使用 string 和 number 原始类型）
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "String": { "message": "使用 string 代替" },
          "Number": { "message": "使用 number 代替" }
          // 可继续添加你要禁止的类型，如 Object、Function 等
        }
      }
    ],

    // 强制使用 import type 导入类型，使导入的类型和值在代码中区分更清晰
    // 选项：prefer 指定优先使用 type-imports，fixStyle 指定自动修复时分开导入
    "typescript/consistent-type-imports": [
      "warn",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],

    // 强制重载签名相邻放置，提高函数重载的可读性
    "typescript/adjacent-overload-signatures": "warn",

    // ========== React 核心规则 ==========

    // 强制 Hooks 的使用规则：只能在顶层和 React 函数组件中调用，不能在条件、循环中调用
    "react/rules-of-hooks": "error",

    // 禁止使用 React.cloneElement，因为它是反模式，可能导致难以维护的代码
    "react/no-clone-element": "warn",

    // 禁止直接修改 this.state，必须使用 setState() 来更新状态
    "react/no-direct-mutation-state": "error",

    // 禁止在 JSX 中出现重复的属性，如 <div id="a" id="b" />
    "react/jsx-no-duplicate-props": "error",

    // 禁止在 JSX 中使用未定义的变量（避免拼写错误或遗漏导入）
    "react/jsx-no-undef": "error",

    // React 17+ 使用新 JSX 转换（自动引入 jsx 函数），无需显式 import React
    // 因此关闭此规则，避免 React 被误报为未使用
    "react/jsx-uses-react": "off",

    // 同上，React 17+ 新转换中，JSX 中的变量不再依赖 React，关闭此规则
    "react/jsx-uses-vars": "off"
  }
}